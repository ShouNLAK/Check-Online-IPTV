<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Check_Online_IPTV.ViewModels"
             x:Class="Check_Online_IPTV.MainPage"
             Title="Check-Online-IPTV Version 2.0"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1E1E1E">

    <ContentPage.BindingContext>
        <viewmodels:ScannerViewModel />
    </ContentPage.BindingContext>

    <!-- Main Grid: Header, Toolbar, DataGrid, Console, Footer -->
    <Grid RowDefinitions="Auto, Auto, *, 200, Auto" Padding="15" RowSpacing="10">
        
        <!-- ROW 0: Header & Network -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                <Label Text="Check-Online-IPTV" FontSize="22" FontAttributes="Bold" TextColor="#007ACC" VerticalOptions="Center"/>
                <Label Text="v2.0" FontSize="14" TextColor="#888888" VerticalOptions="End" Margin="0,0,0,4"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Label Text="🌐" FontSize="16" VerticalOptions="Center"/>
                <Label Text="{Binding NetworkStatus}" FontSize="13" TextColor="#FFC107" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- ROW 1: Toolbar -->
        <Border Grid.Row="1" BackgroundColor="#252526" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Text="📂 Browse" Command="{Binding LoadFileCommand}" BackgroundColor="#333333" TextColor="White" HeightRequest="35" CornerRadius="4" Padding="15,0"/>
                
                <Border Grid.Column="1" BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="10,0">
                    <Label Text="{Binding SelectedFilePath}" TextColor="#AAAAAA" VerticalOptions="Center" LineBreakMode="TailTruncation" FontSize="13"/>
                </Border>

                <Button Grid.Column="2" Text="▶ Start Scan" Command="{Binding StartScanCommand}" BackgroundColor="#007ACC" TextColor="White" FontAttributes="Bold" HeightRequest="35" CornerRadius="4" Padding="20,0"/>
                <Button Grid.Column="3" Text="⏹ Stop" Command="{Binding StopScanCommand}" BackgroundColor="#F44336" TextColor="White" HeightRequest="35" CornerRadius="4" Padding="15,0"/>
            </Grid>
        </Border>

        <!-- ROW 2: Data Grid -->
        <Border Grid.Row="2" BackgroundColor="#252526" StrokeThickness="0" StrokeShape="RoundRectangle 5">
            <Grid RowDefinitions="Auto, *">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="2*, 1*, 1*, 1*, 4*, 1*, 1*, 1*" Padding="10" BackgroundColor="#2D2D30">
                    <Label Grid.Column="0" Text="Name" FontAttributes="Bold" TextColor="#CCCCCC"/>
                    <Label Grid.Column="1" Text="Status" FontAttributes="Bold" TextColor="#CCCCCC" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="2" Text="Resp" FontAttributes="Bold" TextColor="#CCCCCC" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="3" Text="Time" FontAttributes="Bold" TextColor="#CCCCCC" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="4" Text="URL / Direct URL" FontAttributes="Bold" TextColor="#CCCCCC"/>
                    <Label Grid.Column="5" Text="Resolution" FontAttributes="Bold" TextColor="#CCCCCC" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="6" Text="Video" FontAttributes="Bold" TextColor="#CCCCCC" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="7" Text="Audio" FontAttributes="Bold" TextColor="#CCCCCC" HorizontalTextAlignment="Center"/>
                </Grid>
                <!-- Items -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding Channels}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*, 1*, 1*, 1*, 4*, 1*, 1*, 1*" Padding="10">
                                <BoxView Grid.ColumnSpan="8" HeightRequest="1" Color="#333333" VerticalOptions="End"/>
                                
                                <Label Grid.Column="0" Text="{Binding Name}" TextColor="#EEEEEE" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                <Label Grid.Column="1" Text="{Binding Status}" TextColor="{Binding IsLive, Converter={StaticResource BoolToColorConverter}}" HorizontalTextAlignment="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="{Binding ResponseCode}" TextColor="#CCCCCC" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="{Binding ConnectionTimeMs, StringFormat='{0} ms'}" TextColor="#CCCCCC" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                <Label Grid.Column="4" Text="{Binding DisplayUrl}" TextColor="{Binding UrlColor}" VerticalOptions="Center" LineBreakMode="TailTruncation" FontSize="12"/>
                                <Label Grid.Column="5" Text="{Binding Resolution}" TextColor="#CCCCCC" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="12"/>
                                <Label Grid.Column="6" Text="{Binding VideoCodec}" TextColor="#CCCCCC" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="12"/>
                                <Label Grid.Column="7" Text="{Binding AudioCodec}" TextColor="#CCCCCC" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- ROW 3: Live Log Console -->
        <Border Grid.Row="3" BackgroundColor="#0C0C0C" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <Label Grid.Row="0" Text="TERMINAL - LIVE LOGS" TextColor="#555555" FontSize="11" FontAttributes="Bold" Margin="0,0,0,5"/>
                <CollectionView Grid.Row="1" ItemsSource="{Binding LiveLogs}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" TextColor="#00FF00" FontFamily="Consolas, Courier New, monospace" FontSize="12" Margin="0,1"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- ROW 4: Status Bar -->
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
            <ProgressBar Grid.Column="0" Progress="{Binding ProgressFraction}" ProgressColor="#007ACC" HeightRequest="4" VerticalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                <Label Text="Scanned:" TextColor="#888888" FontSize="12"/>
                <Label Text="{Binding ScannedCount}" TextColor="#EEEEEE" FontSize="12" FontAttributes="Bold"/>
                <Label Text="/" TextColor="#888888" FontSize="12"/>
                <Label Text="{Binding TotalChannels}" TextColor="#EEEEEE" FontSize="12" FontAttributes="Bold"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                <Label Text="Live:" TextColor="#888888" FontSize="12"/>
                <Label Text="{Binding LiveCount}" TextColor="#4CAF50" FontSize="12" FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
